# --- Supabase Auth (staff sign-in — same Supabase project as the backend) ---
NEXT_PUBLIC_SUPABASE_URL=""
# The anon/publishable key — safe to expose to the browser. NEVER the
# service_role/secret key (that one stays server-only, in the backend).
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Backend API (Core-Backend repo) ---
# Server-only — never prefixed NEXT_PUBLIC_, since it's only called from
# Server Components/Actions (see src/lib/api.ts), never the browser.
API_URL="http://localhost:3000"
